{
  "name": "sukashawarma-outlet-suite",
  "version": "0.0.2",
  "private": true,
  "engines": {
    "node": ">=23.0.0"
  },
  "description": "Outlet Suite — digitalisasi operasional outlet Sukashawarma",
  "workspaces": [
    "packages/*",
    "apps/*",
    "mobile/*",
    "SUKASHAWARMA"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "type-check": "npm run type-check --workspaces --if-present",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\""
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^20.10.6",
    "@types/react": "^18.2.45",
    "postcss": "^8.5.15",
    "prettier": "^3.1.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.7",
    "dotenv": "^17.4.2",
    "pg": "^8.22.0",
    "xlsx": "^0.18.5"
  }
}
