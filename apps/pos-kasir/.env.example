NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Hanya untuk API Routes (bypass RLS). Jangan bocor ke client.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# SSO: Portal gerbang tunggal. Lokal = http://localhost:3010 ; prod = https://app.sukashawarma.com (ADR-008)
NEXT_PUBLIC_PORTAL_URL=https://app.sukashawarma.com
# Cookie sesi SSO. Kosongkan untuk dev lokal (cookie host-only, dibagi lintas port).
# Prod: .sukashawarma.com agar sesi dibagi lintas subdomain.
NEXT_PUBLIC_COOKIE_DOMAIN=
