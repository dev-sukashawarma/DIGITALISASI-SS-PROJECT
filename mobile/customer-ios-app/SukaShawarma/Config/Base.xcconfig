// Padanan `buildConfigField` di customer-app/app/build.gradle.kts.
//
// Nilai lokal (gateway dev/staging) ditimpa di `Local.xcconfig` yang TIDAK
// di-commit. Catatan xcconfig: `//` memulai komentar, jadi skema URL ditulis
// `https:/$()/` agar dua garis miringnya selamat.
GATEWAY_BASE_URL = https:/$()/retail.sukashawarma.com

// Web client ID Google -- project Google Cloud yang sama dengan provider
// Google di Supabase. Bukan rahasia (lihat komentar di build.gradle.kts).
GOOGLE_WEB_CLIENT_ID = 401597244561-qegnpf2mgcgs43u9hlqvklmmripd1s0m.apps.googleusercontent.com

// iOS client ID -- BELUM ADA. Wajib dibuat di project Google Cloud yang sama
// (tipe iOS, bundle ID com.sukashawarma.customer). Selama kosong, tombol
// "Masuk dengan Google" menampilkan "belum diaktifkan". Bukan rahasia.
GOOGLE_IOS_CLIENT_ID =

#include? "Local.xcconfig"
