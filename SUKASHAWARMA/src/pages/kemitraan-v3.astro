<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Suka Shawarma — Menuju 50 Titik di Jabodetabek</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500;600;700;800&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
<style>
  :root{
    --cream:#FAF3EA; --paper:#FFFFFF;
    --forest:#1F4B3F; --forest-dim:#163832;
    --coral:#E8623F; --ink:#231C15; --ink-soft:rgba(35,28,21,0.6);
    --line:rgba(35,28,21,0.14); --radius:14px; --wrap:1060px;
  }
  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{margin:0;background:var(--cream);color:var(--ink);font-family:'Inter',sans-serif;-webkit-font-smoothing:antialiased;}
  @media (prefers-reduced-motion: reduce){*{animation-duration:0.01ms !important; transition-duration:0.01ms !important; scroll-behavior:auto !important;}}
  a{color:inherit;} img,svg{display:block;max-width:100%;}
  .wrap{max-width:var(--wrap); margin:0 auto; padding:0 28px;}
  h1,h2,h3{font-family:'Instrument Serif', serif; font-weight:400; margin:0;}
  .mono{font-family:'Space Mono', monospace;}
  .eyebrow{display:inline-flex; align-items:center; gap:8px; font-family:'Space Mono', monospace; font-size:12px; letter-spacing:0.12em; text-transform:uppercase; color:var(--coral); margin-bottom:16px;}
  .eyebrow::before{content:""; width:18px; height:1px; background:var(--coral);}

  header{padding:26px 0 0;} header .wrap{display:flex; align-items:center; justify-content:space-between;}
  .wordmark{font-family:'Instrument Serif', serif; font-size:22px; color:var(--ink);}
  .wordmark span{color:var(--coral); font-style:italic;}
  header .tag{font-family:'Space Mono', monospace; font-size:11px; letter-spacing:0.1em; color:var(--ink-soft); text-transform:uppercase;}

  .hero{padding:60px 0 0;}
  .hero-inner{max-width:760px;}
  .hero h1{font-size:clamp(34px,5.6vw,64px); line-height:1.08; color:var(--ink); font-weight:400;}
  .hero h1 em{font-style:italic; color:var(--coral);}
  .hero p.lede{font-size:18px; line-height:1.65; color:var(--ink-soft); max-width:560px; margin:24px 0 0;}
  .hero .disc{font-family:'Space Mono', monospace; font-size:11px; color:rgba(35,28,21,0.42); margin-top:16px;}

  .progress-wrap{margin-top:52px; background:var(--paper); border-radius:var(--radius); padding:34px 36px; box-shadow:0 30px 60px -28px rgba(35,28,21,0.25);}
  .progress-top{display:flex; justify-content:space-between; align-items:baseline; flex-wrap:wrap; gap:10px; margin-bottom:22px;}
  .progress-top .big{font-family:'Instrument Serif', serif; font-size:44px; color:var(--forest);}
  .progress-top .big span{color:var(--coral);}
  .progress-top .cap{font-family:'Space Mono', monospace; font-size:11.5px; letter-spacing:0.06em; text-transform:uppercase; color:var(--ink-soft); text-align:right;}
  .dotgrid{display:grid; grid-template-columns:repeat(10,1fr); gap:7px;}
  .dotgrid .d{aspect-ratio:1; border-radius:4px; background:var(--forest); overflow:hidden; position:relative;}
  .dotgrid .d img{width:100%; height:100%; object-fit:cover; display:block; opacity:0.85; border-radius:4px;}
  .dotgrid .d.empty{background:transparent; border:1.5px dashed rgba(35,28,21,0.28);}
  .progress-legend{display:flex; gap:22px; margin-top:18px; font-family:'Space Mono', monospace; font-size:11.5px; color:var(--ink-soft); flex-wrap:wrap;}
  .progress-legend .item{display:flex; align-items:center; gap:7px;}
  .progress-legend .sw{width:10px; height:10px; border-radius:3px; background:var(--forest);}
  .progress-legend .sw.e{background:transparent; border:1.5px dashed rgba(35,28,21,0.28);}
  .hero .scrollcue{margin-top:28px; margin-bottom:70px; display:inline-flex; align-items:center; gap:10px; font-family:'Space Mono', monospace; font-size:12px; color:var(--forest); text-decoration:none; border-bottom:1px solid var(--forest); padding-bottom:3px;}

  section{padding:88px 0;}
  .section-head{max-width:640px; margin-bottom:48px;}
  .section-head h2{font-size:clamp(26px,3.6vw,40px); color:var(--ink); font-weight:400;}
  .section-head p{color:var(--ink-soft); font-size:16px; line-height:1.65; margin-top:14px;}

  .story-grid{display:grid; grid-template-columns:1.1fr 0.9fr; gap:60px; align-items:start;}
  .story-grid p{color:var(--ink-soft); font-size:16px; line-height:1.75; margin:0 0 16px;}
  .story-side{background:var(--forest); color:var(--cream); border-radius:var(--radius); padding:30px; font-family:'Space Mono', monospace; font-size:12.5px; line-height:2;}
  .story-side .row{display:flex; justify-content:space-between; border-bottom:1px dashed rgba(250,243,234,0.22); padding:6px 0;}
  .story-side .row:last-child{border-bottom:none;}
  .story-side .row b{color:#F2C879;}

  .reveal-band{background:var(--coral); color:#2A0F05; padding:76px 0;}
  .reveal-band .wrap{max-width:720px;}
  .reveal-band .eyebrow{color:#2A0F05;} .reveal-band .eyebrow::before{background:#2A0F05;}
  .reveal-band h2{color:#2A0F05; font-size:clamp(24px,3.4vw,36px); line-height:1.3; font-weight:400;}
  .reveal-band h2 em{font-style:italic;}
  .reveal-band p{color:rgba(42,15,5,0.78); font-size:16px; line-height:1.7; margin-top:18px; max-width:560px;}

  .paket-grid{display:grid; grid-template-columns:1fr 1fr; gap:24px;}
  .paket-card{background:var(--paper); border-radius:var(--radius); overflow:hidden; box-shadow:0 16px 40px -24px rgba(35,28,21,0.3);}
  .paket-head{padding:26px 28px; border-bottom:1px solid var(--line);}
  .paket-head .kicker{font-family:'Space Mono', monospace; font-size:11px; letter-spacing:0.08em; color:var(--ink-soft); text-transform:uppercase;}
  .paket-head h3{font-size:26px; margin-top:8px; font-weight:400;}
  .paket-head .price{font-family:'Instrument Serif', serif; font-size:32px; color:var(--coral); margin-top:8px;}
  .paket-body{padding:4px 28px 26px;}
  .paket-body .li{display:flex; justify-content:space-between; font-size:13.5px; padding:11px 0; border-bottom:1px dotted var(--line);}
  .paket-body .li span:first-child{color:var(--ink-soft);}
  .paket-body .li span:last-child{font-family:'Space Mono', monospace;}
  .paket-note{font-size:12.5px; color:var(--ink-soft); margin-top:18px;}

  .antrian-strip{display:grid; grid-template-columns:repeat(4,1fr); gap:20px;}
  .antrian-item{background:var(--paper); border-radius:var(--radius); padding:28px 24px; box-shadow:0 14px 34px -24px rgba(35,28,21,0.28);}
  .antrian-item .no{font-family:'Space Mono', monospace; font-size:11px; color:var(--coral); margin-bottom:14px; display:block;}
  .antrian-item h3{font-size:18px; margin-bottom:8px; font-weight:400;}
  .antrian-item p{font-size:13px; color:var(--ink-soft); line-height:1.55; margin:0;}

  .faq-item{border-bottom:1px solid var(--line);}
  .faq-q{width:100%; text-align:left; background:none; border:none; cursor:pointer; padding:20px 0; display:flex; justify-content:space-between; align-items:center; font-family:'Instrument Serif', serif; font-size:19px; color:var(--ink); gap:20px;}
  .faq-q .plus{font-family:'Space Mono', monospace; font-size:18px; color:var(--coral); transition:transform 0.25s ease; flex:none;}
  .faq-item.open .faq-q .plus{transform:rotate(45deg);}
  .faq-a{max-height:0; overflow:hidden; transition:max-height 0.3s ease;}
  .faq-a p{color:var(--ink-soft); font-size:14.5px; line-height:1.7; margin:0 0 20px; max-width:640px;}

  .penutup{background:var(--forest); color:var(--cream); text-align:center;}
  .penutup .wrap{max-width:620px;}
  .penutup .eyebrow{color:#F2C879; justify-content:center;} .penutup .eyebrow::before{background:#F2C879;}
  .penutup h2{color:var(--cream); font-size:clamp(26px,3.8vw,42px); line-height:1.25; font-weight:400;}
  .penutup h2 em{font-style:italic; color:#F2C879;}
  .penutup p{color:rgba(250,243,234,0.78); font-size:16px; line-height:1.7; margin:20px auto 32px; max-width:480px;}
  .btn{display:inline-flex; align-items:center; gap:10px; background:var(--coral); color:#FFF; text-decoration:none; padding:16px 32px; border-radius:30px; font-weight:600; font-size:15px;}
  .penutup .contact{margin-top:32px; font-family:'Space Mono', monospace; font-size:12px; color:rgba(250,243,234,0.6);}

  footer{padding:30px 0; text-align:center; font-family:'Space Mono', monospace; font-size:11px; color:var(--ink-soft);}

  @media (max-width:860px){
    .story-grid{grid-template-columns:1fr; gap:32px;}
    .paket-grid{grid-template-columns:1fr;}
    .antrian-strip{grid-template-columns:1fr 1fr;}
    .progress-wrap{padding:26px 22px;}
  }
  @media (max-width:520px){
    .antrian-strip{grid-template-columns:1fr;}
    .dotgrid{grid-template-columns:repeat(5,1fr);}
  }
</style>
</head>
