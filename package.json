{
  "name": "sukashawarma-outlet-suite",
  "version": "0.0.2",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "description": "Outlet Suite — digitalisasi operasional outlet Sukashawarma",
  "workspaces": [
    "packages/*",
    "apps/*",
    "mobile/*",
    "SUKASHAWARMA"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "type-check": "npm run type-check --workspaces --if-present",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\""
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20.10.6",
    "@types/react": "^18.2.45",
    "next": "16.2.12",
    "postcss": "^8.5.15",
    "prettier": "^3.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.45.0",
    "dotenv": "^16.4.7",
    "pg": "^8.13.1",
    "xlsx": "^0.18.5"
  }
}
