NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Cookie sesi SSO. Kosongkan untuk dev lokal (cookie host-only, dibagi lintas port).
# Prod: .sukashawarma.com agar sesi dibagi lintas subdomain. (ADR-008)
NEXT_PUBLIC_COOKIE_DOMAIN=.sukashawarma.com

# URL tiap app untuk Launcher. Lokal = localhost:port, prod = subdomain.
# Bila kosong, Launcher fallback ke subdomain produksi. (ADR-008)
NEXT_PUBLIC_APP_URL_ABSENSI=https://absensi.sukashawarma.com
NEXT_PUBLIC_APP_URL_STOK=https://stok.sukashawarma.com
NEXT_PUBLIC_APP_URL_DISTRIBUSI=https://distribusi.sukashawarma.com
NEXT_PUBLIC_APP_URL_OWNER_DASHBOARD=https://owner.sukashawarma.com
NEXT_PUBLIC_APP_URL_POS_KASIR=https://kasir.sukashawarma.com
NEXT_PUBLIC_APP_URL_MONITORING=https://monitor.sukashawarma.com
