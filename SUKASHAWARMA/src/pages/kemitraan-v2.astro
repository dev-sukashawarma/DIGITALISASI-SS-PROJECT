<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
<style>
  :root{
    --navy:#0F2A2E; --navy2:#163A3F; --card:#123236;
    --cream:#FAF6EE; --cream-soft:rgba(250,246,238,0.62);
    --coral:#FF6B4A; --yellow:#FFC857; --line:rgba(250,246,238,0.14);
    --radius:8px; --wrap:1080px;
  }
  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{margin:0;background:var(--navy);color:var(--cream);font-family:'Manrope',sans-serif;-webkit-font-smoothing:antialiased;}
  @media (prefers-reduced-motion: reduce){*{animation-duration:0.01ms !important; transition-duration:0.01ms !important; scroll-behavior:auto !important;}}
  a{color:inherit;} img,svg{display:block;max-width:100%;}
  .wrap{max-width:var(--wrap); margin:0 auto; padding:0 28px;}
  h1,h2,h3{font-family:'Space Grotesk', sans-serif; font-weight:600; margin:0; letter-spacing:-0.01em;}
  .mono{font-family:'Space Mono', monospace;}
  .eyebrow{display:inline-flex; align-items:center; gap:8px; font-family:'Space Mono', monospace; font-size:12px; letter-spacing:0.12em; text-transform:uppercase; color:var(--yellow); margin-bottom:18px;}
  .eyebrow::before{content:""; width:18px; height:1px; background:var(--yellow);}

  header{padding:26px 0 0;} header .wrap{display:flex; align-items:center; justify-content:space-between;}
  .wordmark{font-family:'Space Grotesk', sans-serif; font-weight:700; font-size:19px; color:var(--cream);}
  .wordmark span{color:var(--coral);}
  header .tag{font-family:'Space Mono', monospace; font-size:11px; letter-spacing:0.1em; color:var(--cream-soft); text-transform:uppercase;}

  .hero{position:relative; overflow:hidden; padding:64px 0 40px;}
  .hero-map{position:absolute; right:-60px; top:-20px; width:480px; opacity:0.9; pointer-events:none;}
  .node{animation:pulse 2.6s ease-in-out infinite;}
  .node.d2{animation-delay:0.4s;} .node.d3{animation-delay:0.8s;} .node.d4{animation-delay:1.2s;} .node.d5{animation-delay:1.6s;}
  @keyframes pulse{ 0%,100%{opacity:0.5; r:3;} 50%{opacity:1; r:5;} }
  .hero-inner{position:relative; max-width:740px;}
  .hero h1{font-size:clamp(32px,5.2vw,58px); line-height:1.08; color:var(--cream);}
  .hero h1 .hl{color:var(--coral);}
  .hero p.lede{font-size:17px; line-height:1.65; color:var(--cream-soft); max-width:540px; margin:24px 0 0;}
  .hero .disc{font-family:'Space Mono', monospace; font-size:11px; color:rgba(250,246,238,0.4); margin-top:16px;}
  .hero .scrollcue{margin-top:36px; display:inline-flex; align-items:center; gap:10px; font-family:'Space Mono', monospace; font-size:12px; color:var(--yellow); text-decoration:none; border-bottom:1px solid var(--yellow); padding-bottom:3px;}

  .stat-strip{border-top:1px solid var(--line); border-bottom:1px solid var(--line); background:var(--navy2);}
  .stat-strip .wrap{display:grid; grid-template-columns:repeat(4,1fr);}
  .stat-strip .stat{padding:24px 20px; text-align:center; border-right:1px solid var(--line);}
  .stat-strip .stat:last-child{border-right:none;}
  .stat .num{font-family:'Space Grotesk', sans-serif; font-weight:700; font-size:28px; color:var(--yellow);}
  .stat .lbl{font-family:'Space Mono', monospace; font-size:10.5px; letter-spacing:0.06em; color:var(--cream-soft); margin-top:6px; text-transform:uppercase;}

  section{padding:88px 0;}
  .section-head{max-width:640px; margin-bottom:48px;}
  .section-head h2{font-size:clamp(24px,3.2vw,36px); color:var(--cream);}
  .section-head p{color:var(--cream-soft); font-size:15.5px; line-height:1.65; margin-top:14px;}

  .story-grid{display:grid; grid-template-columns:1.1fr 0.9fr; gap:58px; align-items:start;}
  .story-grid blockquote{font-family:'Space Grotesk', serif; font-style:italic; font-size:21px; line-height:1.5; color:var(--yellow); margin:0; padding-left:20px; border-left:2px solid var(--coral);}
  .story-grid p{color:var(--cream-soft); font-size:15.5px; line-height:1.75; margin:16px 0 0;}
  .nodemap-list{background:var(--card); border-radius:var(--radius); padding:26px; font-family:'Space Mono', monospace; font-size:12.5px;}
  .nodemap-list .row{display:flex; justify-content:space-between; align-items:center; padding:9px 0; border-bottom:1px dashed var(--line);}
  .nodemap-list .row:last-child{border-bottom:none;}
  .nodemap-list .row .dotlabel{display:flex; align-items:center; gap:8px; color:var(--cream-soft);}
  .nodemap-list .row .dotlabel::before{content:""; width:6px; height:6px; border-radius:50%; background:var(--coral);}
  .nodemap-list .row b{color:var(--yellow);}

  .reveal-band{background:var(--coral); color:#1A0D08; padding:70px 0;}
  .reveal-band .wrap{max-width:720px;}
  .reveal-band .eyebrow{color:#1A0D08;} .reveal-band .eyebrow::before{background:#1A0D08;}
  .reveal-band h2{color:#1A0D08; font-size:clamp(22px,3vw,32px); line-height:1.3;}
  .reveal-band p{color:rgba(26,13,8,0.8); font-size:15.5px; line-height:1.7; margin-top:16px; max-width:560px;}

  .angka-grid{display:grid; grid-template-columns:0.95fr 1.05fr; gap:56px; align-items:center;}
  .angka-grid ul{margin:22px 0 0; padding:0; list-style:none;}
  .angka-grid li{display:flex; gap:12px; align-items:flex-start; font-size:14.5px; color:var(--cream); padding:10px 0; border-bottom:1px solid var(--line);}
  .angka-grid li:last-child{border-bottom:none;}
  .angka-grid li .dot{width:6px; height:6px; border-radius:50%; background:var(--yellow); margin-top:7px; flex:none;}

  .node-wrap{display:flex; justify-content:center;}
  .nodecard{background:var(--cream); color:#0F2A2E; border-radius:var(--radius); width:100%; max-width:410px; padding:28px 28px 8px; box-shadow:0 26px 60px -20px rgba(0,0,0,0.5);}
  .nodecard-head{display:flex; align-items:center; gap:10px; padding-bottom:14px; margin-bottom:4px; border-bottom:2px solid #0F2A2E;}
  .nodecard-head .pin{width:10px; height:10px; border-radius:50%; background:var(--coral); flex:none;}
  .nodecard-head .t{font-family:'Space Mono', monospace; font-size:11px; letter-spacing:0.08em; text-transform:uppercase; color:rgba(15,42,46,0.55);}
  .nc-line{display:flex; justify-content:space-between; gap:10px; font-family:'Space Mono', monospace; font-size:12.5px; padding:10px 0; border-bottom:1px dotted rgba(15,42,46,0.16);}
  .nc-line span:first-child{color:rgba(15,42,46,0.55);}
  .nc-total{display:flex; justify-content:space-between; align-items:baseline; padding:16px 0 6px; margin-top:4px; border-top:2px solid #0F2A2E;}
  .nc-total .l{font-family:'Space Mono', monospace; font-size:10.5px; letter-spacing:0.08em; text-transform:uppercase; color:rgba(15,42,46,0.55);}
  .nc-total .v{font-family:'Space Grotesk', sans-serif; font-weight:700; font-size:26px; color:var(--coral);}
  .nc-note{font-size:10px; font-family:'Space Mono', monospace; color:rgba(15,42,46,0.5); line-height:1.6; padding:12px 0 14px; margin-top:8px; border-top:1px solid rgba(15,42,46,0.12);}

  .fase-grid{display:grid; grid-template-columns:1fr 1fr; gap:22px;}
  .fase-card{background:var(--card); border-radius:var(--radius); padding:32px 28px;}
  .fase-card .fase-tag{font-family:'Space Mono', monospace; font-size:11px; letter-spacing:0.08em; text-transform:uppercase; color:var(--yellow); margin-bottom:12px; display:block;}
  .fase-card h3{font-size:21px; margin-bottom:9px;}
  .fase-card p{color:var(--cream-soft); font-size:14px; line-height:1.65; margin:0;}

  .paket-grid{display:grid; grid-template-columns:1fr 1fr; gap:24px;}
  .paket-card{background:var(--card); border-radius:var(--radius); overflow:hidden;}
  .paket-head{padding:24px 26px; border-bottom:1px solid var(--line);}
  .paket-head .kicker{font-family:'Space Mono', monospace; font-size:11px; letter-spacing:0.08em; color:var(--cream-soft); text-transform:uppercase;}
  .paket-head h3{font-size:22px; margin-top:8px;}
  .paket-head .price{font-family:'Space Grotesk', sans-serif; font-weight:700; font-size:28px; color:var(--yellow); margin-top:8px;}
  .paket-body{padding:4px 26px 24px;}
  .paket-body .li{display:flex; justify-content:space-between; font-size:13px; padding:10px 0; border-bottom:1px dotted var(--line); font-family:'Space Mono', monospace;}
  .paket-body .li span:first-child{color:var(--cream-soft); font-family:'Manrope',sans-serif;}

  .antrian-strip{display:grid; grid-template-columns:repeat(4,1fr); border:1px solid var(--line); background:var(--card);}
  .antrian-item{padding:28px 22px; border-right:1px solid var(--line);}
  .antrian-item:last-child{border-right:none;}
  .antrian-item .no{font-family:'Space Mono', monospace; font-size:11px; color:var(--coral); border:1px solid var(--coral); display:inline-block; padding:2px 8px; border-radius:2px; margin-bottom:14px;}
  .antrian-item h3{font-size:15px; margin-bottom:7px;}
  .antrian-item p{font-size:12.5px; color:var(--cream-soft); line-height:1.55; margin:0;}

  .faq-item{border-bottom:1px solid var(--line);}
  .faq-q{width:100%; text-align:left; background:none; border:none; cursor:pointer; padding:20px 0; display:flex; justify-content:space-between; align-items:center; font-family:'Space Grotesk', sans-serif; font-weight:600; font-size:16px; color:var(--cream); gap:20px;}
  .faq-q .plus{font-family:'Space Mono', monospace; font-size:17px; color:var(--yellow); transition:transform 0.25s ease; flex:none;}
  .faq-item.open .faq-q .plus{transform:rotate(45deg);}
  .faq-a{max-height:0; overflow:hidden; transition:max-height 0.3s ease;}
  .faq-a p{color:var(--cream-soft); font-size:14px; line-height:1.7; margin:0 0 20px; max-width:640px;}

  .penutup{background:var(--yellow); color:#1A1204; text-align:center;}
  .penutup .wrap{max-width:600px;}
  .penutup .eyebrow{color:#1A1204; justify-content:center;} .penutup .eyebrow::before{background:#1A1204;}
  .penutup h2{color:#1A1204; font-size:clamp(24px,3.4vw,38px); line-height:1.25;}
  .penutup h2 .hl{color:var(--coral);}
  .penutup p{color:rgba(26,18,4,0.72); font-size:15.5px; line-height:1.7; margin:18px auto 30px; max-width:480px;}
  .btn{display:inline-flex; align-items:center; gap:10px; background:#0F2A2E; color:var(--cream); text-decoration:none; padding:15px 30px; border-radius:30px; font-weight:700; font-size:15px;}
  .penutup .contact{margin-top:30px; font-family:'Space Mono', monospace; font-size:12px; color:rgba(26,18,4,0.6);}

  footer{padding:30px 0; text-align:center; font-family:'Space Mono', monospace; font-size:11px; color:var(--cream-soft);}

  @media (max-width:860px){
    .story-grid, .angka-grid{grid-template-columns:1fr; gap:30px;}
    .fase-grid, .paket-grid{grid-template-columns:1fr;}
    .stat-strip .wrap{grid-template-columns:1fr 1fr;}
    .stat-strip .stat:nth-child(2){border-right:none;}
    .antrian-strip{grid-template-columns:1fr 1fr;}
    .antrian-item:nth-child(2){border-right:none;}
    .antrian-item:nth-child(3), .antrian-item:nth-child(4){border-top:1px solid var(--line);}
    .hero-map{display:none;}
  }
  @media (max-width:520px){
    .antrian-strip{grid-template-columns:1fr;}
    .antrian-item{border-right:none !important; border-top:1px solid var(--line);}
    .antrian-item:first-child{border-top:none;}
  }

  /* ── Gallery ── */
  .gallery-section{padding:80px 0; background:var(--navy2);}
  .gallery-section .section-head{margin-bottom:36px;}
  .gallery-section .section-head h2{color:var(--cream);}
  .gallery-section .section-head p{color:var(--cream-soft);}
  .gallery-grid{display:grid; grid-template-columns:repeat(3,1fr); gap:12px;}
  .gallery-grid .gitem{border-radius:var(--radius); overflow:hidden; aspect-ratio:4/3;}
  .gallery-grid .gitem img{width:100%; height:100%; object-fit:cover; display:block; transition:transform 0.4s ease;}
  .gallery-grid .gitem:hover img{transform:scale(1.06);}
  /* menu section */
  .menu-section{padding:72px 0; background:var(--navy);}
  .menu-section .section-head{margin-bottom:40px;}
  .menu-section .section-head h2{color:var(--cream);}
  .menu-section .section-head p{color:var(--cream-soft); font-size:15px;}
  .menu-grid{display:grid; grid-template-columns:repeat(4,1fr); gap:16px;}
  .mcard{background:#fff; border-radius:12px; padding:22px 16px 16px; text-align:center; transition:transform 0.3s ease, box-shadow 0.3s ease; box-shadow:0 4px 16px rgba(0,0,0,0.15);}
  .mcard:hover{transform:translateY(-5px); box-shadow:0 10px 28px rgba(0,0,0,0.22);}
  .mcard img{width:100%; aspect-ratio:1; object-fit:contain; margin-bottom:10px;}
  .mcard span{font-size:12px; font-weight:700; color:#222; font-family:'Space Mono', monospace; display:block; margin-top:4px;}
  @media(max-width:860px){
    .gallery-grid{grid-template-columns:repeat(2,1fr);}
    .menu-strip{grid-template-columns:repeat(3,1fr);}
    .menu-grid{grid-template-columns:repeat(2,1fr);}
  }
  @media(max-width:520px){
    .menu-grid{grid-template-columns:repeat(2,1fr);}
  }
</style>
</head>
<body>

<header><div class="wrap"><div class="wordmark">Suka<span>Shawarma</span></div><div class="tag">Bogor — Jabodetabek</div></div></header>

<section class="hero">
  <svg class="hero-map" viewBox="0 0 300 300" aria-hidden="true">
    <g stroke="#FAF6EE" stroke-opacity="0.15" stroke-width="1">
      <line x1="60" y1="70" x2="130" y2="110"/><line x1="130" y1="110" x2="200" y2="90"/>
      <line x1="130" y1="110" x2="160" y2="180"/><line x1="160" y1="180" x2="90" y2="210"/>
      <line x1="200" y1="90" x2="240" y2="150"/><line x1="160" y1="180" x2="230" y2="200"/>
    </g>
    <circle class="node" cx="60" cy="70" r="4" fill="#FFC857"/>
    <circle class="node d2" cx="130" cy="110" r="4" fill="#FF6B4A"/>
    <circle class="node d3" cx="200" cy="90" r="4" fill="#FFC857"/>
    <circle class="node d4" cx="160" cy="180" r="4" fill="#FF6B4A"/>
    <circle class="node d5" cx="90" cy="210" r="4" fill="#FFC857"/>
    <circle class="node d3" cx="240" cy="150" r="4" fill="#FF6B4A"/>
    <circle class="node d2" cx="230" cy="200" r="4" fill="#FFC857"/>
  </svg>
  <div class="wrap">
    <div class="hero-inner">
      <h1>Ada gerakan yang lagi <span class="hl">meluas</span> di Jabodetabek — dan titiknya terus nambah.</h1>
      <p class="lede">Dari satu titik di Bogor Mei 2024, sekarang 20+ outlet Suka Shawarma tersebar di Jabodetabek. Tiap titik baru dijalankan orang yang tadinya nggak ada di dunia F&B sama sekali.</p>
      <p class="disc">*Ilustrasi sebaran outlet, bukan proyeksi ekspansi masa depan atau jaminan hasil.</p>
      <a href="#pembuka" class="scrollcue">Lihat titik-titiknya ↓</a>
    </div>
  </div>
</section>

<div class="stat-strip">
  <div class="wrap">
    <div class="stat"><div class="num">20+</div><div class="lbl">Titik Aktif</div></div>
    <div class="stat"><div class="num">Mei '24</div><div class="lbl">Titik Pertama</div></div>
    <div class="stat"><div class="num">28K+</div><div class="lbl">Followers IG</div></div>
    <div class="stat"><div class="num">Halal</div><div class="lbl">Sertifikasi MUI</div></div>
  </div>
</div>

<section id="pembuka">
  <div class="wrap">
    <div class="section-head"><span class="eyebrow">Sebaran</span><h2>Dari satu gerobak, jadi jaringan titik</h2></div>
    <div class="story-grid">
      <div>
        <blockquote>"Menghadirkan pengalaman kuliner Timur Tengah ke jalanan Indonesia — harga terjangkau, kualitas tetap dijaga."</blockquote>
        <p style="margin-top:24px;">Suka Shawarma mulai Mei 2024 di Bogor. Nggak sampai dua tahun, jaringannya nyampe lebih dari 20 titik se-Jabodetabek — dan tiap titik baru dipegang orang berbeda-beda, bukan cuma satu keluarga atau grup tertutup.</p>
        <p>Yang bikin jaringan ini bisa terus meluas: sistem operasional dan training yang sama dipakai di tiap titik, jadi kualitasnya konsisten dari Bogor sampai Depok.</p>
      </div>
      <div class="nodemap-list">
        <div class="row"><span class="dotlabel">Bogor &amp; sekitarnya</span><b>Titik pertama</b></div>
        <div class="row"><span class="dotlabel">Depok</span><b>Beberapa titik</b></div>
        <div class="row"><span class="dotlabel">Jakarta Selatan</span><b>Beberapa titik</b></div>
        <div class="row"><span class="dotlabel">Bekasi</span><b>Beberapa titik</b></div>
        <div class="row"><span class="dotlabel">Total jaringan</span><b>20+ titik</b></div>
      </div>
    </div>
  </div>
</section>

<div class="reveal-band">
  <div class="wrap">
    <span class="eyebrow">Cara Titik Baru Terbentuk</span>
    <h2>Tiap titik baru lahir lewat kemitraan — kamu sediakan modal &amp; lokasi, tim kami yang jalankan.</h2>
    <p>Rekrutmen staf, produksi harian, sampai laporan bulanan dipegang tim kami. Kamu jadi bagian dari jaringannya, bukan operatornya. Performa tiap titik tetap dipengaruhi lokasi dan kondisi pasar setempat — bukan sesuatu yang bisa dijamin sama di semua titik.</p>
  </div>
</div>

<!-- Menu Section (dipindah ke sini, setelah reveal-band) -->
<section class="menu-section">
  <div class="wrap">
    <div class="section-head">
      <span class="eyebrow">Menu Andalan</span>
      <h2>Produk yang bikin orang balik lagi</h2>
      <p>Shawarma autentik dengan harga mulai 20rb-an — ini yang dijual tiap hari di semua outlet.</p>
    </div>
    <div class="menu-grid">
      <div class="mcard"><img src="/menus/SS_SUKA_CHICKEN.png" alt="Suka Chicken" loading="lazy"><span>Suka Chicken</span></div>
      <div class="mcard"><img src="/menus/SS_SUKA_BEEF.png" alt="Suka Beef" loading="lazy"><span>Suka Beef</span></div>
      <div class="mcard"><img src="/menus/SS_SHAWARMIE_AYAM.png" alt="Shawarmie Ayam" loading="lazy"><span>Shawarmie Ayam</span></div>
      <div class="mcard"><img src="/menus/SS_SHAWARMIE_SAPI.png" alt="Shawarmie Sapi" loading="lazy"><span>Shawarmie Sapi</span></div>
      <div class="mcard"><img src="/menus/ORI SHAWARMA MIX.png" alt="Shawarma Mix" loading="lazy"><span>Shawarma Mix</span></div>
      <div class="mcard"><img src="/menus/SS_SUKA_SAMYANG.png" alt="Suka Samyang" loading="lazy"><span>Suka Samyang</span></div>
      <div class="mcard"><img src="/menus/SS_SUKA_FRIED_CHICKEN.png" alt="Fried Chicken" loading="lazy"><span>Suka Fried Chicken</span></div>
      <div class="mcard"><img src="/menus/ORI AYAM.png" alt="Ori Ayam" loading="lazy"><span>Ori Ayam</span></div>
    </div>
  </div>
</section>

<section>
  <div class="wrap">
    <div class="section-head"><span class="eyebrow">Angka Satu Titik</span><h2>Simulasi kalau kamu buka titik baru</h2><p>Contoh paket Own Location — kamu sudah punya lokasi, tim kami yang setup dan jalankan operasionalnya.</p></div>
    <div class="angka-grid">
      <div>
        <ul>
