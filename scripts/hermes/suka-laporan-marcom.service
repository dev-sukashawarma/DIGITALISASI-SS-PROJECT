[Unit]
Description=Laporan Status Marcom Endorsement & Ads Suka Shawarma ke Telegram (04:00 WIB)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/env python3 %h/bin/kirim-laporan-telegram.py --jenis marcom
StandardOutput=journal
StandardError=journal
