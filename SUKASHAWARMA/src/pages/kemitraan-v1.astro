---
// Route: /kemitraan-v1
---

<!doctype html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Suka Shawarma — Cerita di Balik Antrian</title>

  <!-- Google tag (gtag.js) -->
