NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Hanya untuk API Routes (bypass RLS). Jangan bocor ke client.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# SSO: Portal gerbang tunggal. Lokal = http://localhost:3010 ; prod = https://app.sukashawarma.com (ADR-008)
NEXT_PUBLIC_PORTAL_URL=https://app.sukashawarma.com
# Cookie sesi SSO. Kosongkan untuk dev lokal (cookie host-only, dibagi lintas port).
# Prod: .sukashawarma.com agar sesi dibagi lintas subdomain.
NEXT_PUBLIC_COOKIE_DOMAIN=

# ── Integrasi Order Online (SS_ORDER) ──────────────────────────────────────
# Secret yang dipakai order-system untuk push order baru ke /api/orders/incoming.
# Harus identik dengan secret yang disetel di Supabase Secrets order-system.
ORDER_TO_KASIR_SECRET=

# Secret yang dipakai pos-kasir untuk notify order-system saat kasir tekan "Selesai".
# Harus identik dengan secret yang disetel di Supabase Secrets order-system.
KASIR_TO_ORDER_SECRET=

# URL Edge Function order-system yang menerima notifikasi "order selesai" dari pos-kasir.
# Staging: https://<ref-staging>.supabase.co/functions/v1/kasir-order-done
ORDER_SYSTEM_NOTIFY_URL=
