[Unit]
Description=Laporan Penjualan Closing Malam (s.d. 22:00 WIB) Suka Shawarma ke Telegram
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/env python3 %h/bin/kirim-laporan-telegram.py --jenis sales-malam
StandardOutput=journal
StandardError=journal
