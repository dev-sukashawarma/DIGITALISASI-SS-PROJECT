<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>GatewayBaseURL</key>
	<string>$(GATEWAY_BASE_URL)</string>
	<key>GoogleWebClientID</key>
	<string>$(GOOGLE_WEB_CLIENT_ID)</string>
	<key>GoogleIOSClientID</key>
	<string>$(GOOGLE_IOS_CLIENT_ID)</string>
	<!-- Hanya HTTPS standar (tanpa enkripsi sendiri): bebas dokumen ekspor. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Lokasi kasar, HANYA untuk mengurutkan outlet terdekat di Pilih Outlet.
	     Tidak disimpan dan tidak dikirim ke gateway. -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Lokasimu dipakai untuk mengurutkan outlet Suka Shawarma dari yang terdekat. Lokasi tidak disimpan dan tidak dikirim ke server.</string>
	<key>UILaunchScreen</key>
	<dict>
		<!-- Cokelat Suka, supaya peralihan ke splash aplikasi tidak berkedip putih. -->
		<key>UIColorName</key>
		<string>LaunchBackground</string>
		<!-- Logo di tengah, sama dengan splash sistem Android (logo_suka di atas
		     cokelat). Ukurannya sama dengan SplashMerekView agar peralihan mulus. -->
		<key>UIImageName</key>
		<string>LogoSplash</string>
	</dict>
	<key>UIAppFonts</key>
	<array>
		<string>lilita_one.ttf</string>
		<string>plus_jakarta_sans_regular.ttf</string>
		<string>plus_jakarta_sans_medium.ttf</string>
		<string>plus_jakarta_sans_bold.ttf</string>
	</array>
</dict>
</plist>
